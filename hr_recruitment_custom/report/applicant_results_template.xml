<odoo>
    <template id="applicant_results_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">

                    <!-- Header -->
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <h2>Shortlist Report</h2>
                            <h4 t-esc="job.name"/>
                        </div>
                    </div>

                    <!-- Job Info -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>Job: </strong>
                            <span t-esc="job.name or '-'"/>
                        </div>
                        <div class="col-6">
                            <strong>Positions Required: </strong>
                            <span t-esc="needed"/>
                        </div>
                        <div class="col-6 mt-2">
                            <strong>Completed: </strong>
                            <span t-esc="total_completed"/>
                        </div>
                        <div class="col-6 mt-2">
                            <strong>Announcement Date: </strong>
                            <span t-esc="job.announcement_date or '-'"/>
                        </div>
                        <div class="col-6 mt-2">
                            <strong>Scoring Criteria: </strong>
                            <span t-if="job.scoring_criteria == 'exam_only'">Exam Only</span>
                            <span t-elif="job.scoring_criteria == 'interview_only'">Interview Only</span>
                            <span t-else="">Exam and Observation</span>
                        </div>
                    </div>

                    <!-- Shortlist Table -->
                    <h5 class="mt-4 mb-2" style="color: #2c7be5;">
                        ✓ Selected Candidates
                        <small class="text-muted"> (Top <t t-esc="needed"/>)</small>
                    </h5>

                    <t t-if="shortlist">
                        <table class="table table-sm table-bordered">
                            <thead style="background-color: #045318; color: white;">
                                <tr>
                                    <th style="width:5%"><b>#</b></th>
                                    <th class="text-center"><b>Candidate Name</b></th>
                                    <th class="text-center"><b>National ID</b></th>
                                    <th t-if="job.scoring_criteria != 'interview_only'" class="text-center"><b>Exam Score (%)</b></th>
                                    <t t-if="job.scoring_criteria != 'exam_only'">
                                        <th class="text-center"><b>Interview Score (%)</b></th>
                                    </t>
                                    <th class="text-center"><b>Total (%)</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="shortlist" t-as="r">
                                    <tr>
                                        <td t-esc="r_index + 1"/>
                                        <td t-esc="r['name']"/>
                                        <td t-esc="r['nationality_no']"/>
                                        <td t-if="job.scoring_criteria != 'interview_only'" class="text-center" t-esc="r['exam_score']"/>
                                        <t t-if="job.scoring_criteria != 'exam_only'">
                                            <td class="text-center" t-esc="r['interview_score']"/>
                                        </t>
                                        <td class="text-center">
                                            <strong t-esc="r['total']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <t t-if="job.scoring_criteria == 'exam_only'">
                            <p class="text-muted">No candidates completed the exam.</p>
                        </t>
                        <t t-elif="job.scoring_criteria == 'interview_only'">
                            <p class="text-muted">No candidates completed the interview.</p>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No candidates completed both exam and interview.</p>
                        </t>
                    </t>

                    <!-- Others Table -->
                    <t t-if="others">
                        <h5 class="mt-5 mb-2" style="color: #6c757d;">
                            Remaining Candidates
                        </h5>
                        <table class="table table-sm table-bordered">
                            <thead style="background-color: #6c757d; color: white;">
                                <tr>
                                    <th style="width:5%"><b>#</b></th>
                                    <th class="text-center"><b>Candidate Name</b></th>
                                    <th class="text-center"><b>National ID</b></th>
                                    <th t-if="job.scoring_criteria != 'interview_only'" class="text-center"><b>Exam Score (%)</b></th>
                                    <t t-if="job.scoring_criteria != 'exam_only'">
                                        <th class="text-center"><b>Interview Score (%)</b></th>
                                    </t>
                                    <th class="text-center"><b>Total (%)</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="others" t-as="r">
                                    <tr>
                                        <td t-esc="r_index + needed + 1"/>
                                        <td t-esc="r['name']"/>
                                        <td t-esc="r['nationality_no']"/>
                                        <td t-if="job.scoring_criteria != 'interview_only'" class="text-center" t-esc="r['exam_score']"/>
                                        <t t-if="job.scoring_criteria != 'exam_only'">
                                            <td class="text-center" t-esc="r['interview_score']"/>
                                        </t>
                                        <td class="text-center" t-esc="r['total']"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                </div>
            </t>
        </t>
    </template>
</odoo>
