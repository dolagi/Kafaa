<odoo>
    <template id="interview_form_report">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="report">
                <t t-call="web.external_layout">
                    <div class="page" style="direction: rtl; font-family: 'Arial', sans-serif; font-size: 11px;">
 
                        <!-- Header -->
                        <div style="text-align: center; margin-bottom: 8px;">
                            <div style="font-size: 13px;">بسم الله الرحمن الرحيم</div>
                            <div style="font-size: 12px; margin-top: 3px;">وزارة مجلس الوزراء</div>
                            <div style="font-size: 12px; margin-top: 2px;">مفوضية الاختيار للخدمة المدنية القومية</div>
                            <div style="font-size: 13px; font-weight: bold; text-decoration: underline; margin-top: 6px;">
                                استمارة معاينة — <t t-esc="report['job'].name"/>
                            </div>
                        </div>
 
                        <!-- Table -->
                        <table style="width:100%; border-collapse:collapse; font-size:10px; text-align:center;">
 
                            <!-- ROW 1: column headers -->
                            <tr style="background:#D9D9D9;">
                                <td style="border:1px solid black; font-weight:bold; width:4%; vertical-align:middle; padding:4px;">الرقم</td>
                                <td style="border:1px solid black; font-weight:bold; width:16%; vertical-align:middle; padding:4px;">الاسم رباعي</td>
                                <!-- Dynamic question titles -->
                                <t t-foreach="report['questions']" t-as="q">
                                    <td style="border:1px solid black; font-weight:bold; vertical-align:middle; padding:4px;">
                                        <t t-esc="q.title"/>
                                    </td>
                                </t>
                                <td style="border:1px solid black; font-weight:bold; width:7%; vertical-align:middle; padding:4px;">المجموع %</td>
                                <td style="border:1px solid black; font-weight:bold; width:12%; vertical-align:middle; padding:4px;">ملاحظات</td>
                            </tr>
 
                            <!-- ROW 2: max scores per question -->
                            <tr style="background:#A6A6A6; font-size:10px;">
                                <td style="border:1px solid black; padding:3px;"></td>
                                <td style="border:1px solid black; padding:3px;"></td>
                                <t t-foreach="report['questions']" t-as="q">
                                    <td style="border:1px solid black; padding:3px;">
                                        <t t-esc="report['max_score_map'].get(q.id, '')"/>
                                    </td>
                                </t>
                                <td style="border:1px solid black; padding:3px;"></td>
                                <td style="border:1px solid black; padding:3px;"></td>
                            </tr>
 
                            <!-- Data rows -->
                            <t t-foreach="report['candidates']" t-as="c">
                                <tr style="height:26px;">
                                    <td style="border:1px solid black;" t-esc="c['index']"/>
                                    <td style="border:1px solid black; text-align:right; padding-right:4px;" t-esc="c['name']"/>
                                    <t t-foreach="report['questions']" t-as="q">
                                        <td style="border:1px solid black;">
                                            <t t-esc="c['scores'].get(q.id, '')"/>
                                        </td>
                                    </t>
                                    <td style="border:1px solid black;" t-esc="c['total']"/>
                                    <td style="border:1px solid black;"></td>
                                </tr>
                            </t>
 
                        </table>
 
                        <!-- Footer info -->
                        <div style="margin-top:12px; font-size:11px; text-align:right; direction:rtl; line-height:2.2;">
                            الوحدة: ......................................
                            التخصص: ......................................
                            تاريخ المعاينة: ......................................
                            رقم الكشف: ......................................
                        </div>
 
                        <!-- Signatures -->
                        <div style="margin-top:20px; font-size:11px; direction:rtl; line-height:3.5;">
                            <div style="display:flex; justify-content:space-between;">
                                <span>رئيس اللجنة: ............................... التوقيع: .........................</span>
                                <span>عضو اللجنة: ............................... التوقيع: .........................</span>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span>عضو اللجنة: ............................... التوقيع: .........................</span>
                                <span>المقرر: ............................... التوقيع: .........................</span>
                            </div>
                        </div>
 
                    </div>
                </t>
            </t>
        </t>
    </template>
 
</odoo>
 
