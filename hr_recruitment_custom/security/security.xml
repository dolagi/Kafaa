<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Information Center -->
    <record id="group_information_center" model="res.groups">
        <field name="name">Information Center</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
    </record>

    <!-- General Secretariat -->
    <record id="group_general_secretariat" model="res.groups">
        <field name="name">General Secretariat</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
    </record>

    <!-- Selection Affairs Department -->
    <record id="group_selection_affairs" model="res.groups">
        <field name="name">Selection Affairs Department</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
    </record>

    <!-- Examinations Department -->
    <record id="group_examinations_department" model="res.groups">
        <field name="name">Examinations Department</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        <field name="implied_ids" eval="[(4, ref('survey.group_survey_manager'))]"/>
    </record>

    <!-- Inspection Committee -->
    <record id="group_inspection_committee" model="res.groups">
        <field name="name">Inspection Committee</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
    </record>

    <record id="hr_job_info_center_rule" model="ir.rule">
        <field name="name">Information Center: All Applicants</field>
        <field name="model_id" ref="model_hr_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment_custom.group_information_center'))]"/>
    </record>

    <record id="hr_applicant_info_center_rule" model="ir.rule">
        <field name="name">Information Center: All Applicants</field>
        <field name="model_id" ref="model_hr_applicant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment_custom.group_information_center'))]"/>
    </record>

    <record id="survey_information_center_exam_rule" model="ir.rule">
        <field name="name">Information Center: Job Exams Only</field>
        <field name="model_id" ref="survey.model_survey_survey"/>
        <field name="domain_force">[('id', 'in', user.env['hr.job'].search([]).mapped('exam_id').ids)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment_custom.group_information_center'))]"/>
    </record>

</odoo>
