<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_survey_send_participants_wizard_form" model="ir.ui.view">
        <field name="name">survey.send.participants.wizard.form</field>
        <field name="model">survey.send.participants.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Survey Participants">
                <group>
                    <field name="partner_id"/>
                </group>
                <footer>
                    <button name="action_send" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>