<odoo>
<data noupdate="1">
    <record id="default_recruitment_feedback_survey" model="survey.survey">
        <field name="title">Recruitment Process Feedback</field>
        <field name="survey_type">assessment</field>
        <field name="access_mode">public</field>
        <field name="scoring_type">no_scoring</field>
        <field name="active">1</field>
    </record>

    <record id="feedback_survey_question_rating" model="survey.question">
        <field name="survey_id" ref="default_recruitment_feedback_survey"/>
        <field name="title">How would you rate the recruitment process?</field>
        <field name="question_type">scale</field>
        <field name="scale_min">1</field>
        <field name="scale_max">5</field>
        <field name="scale_min_label">Very Poor</field>
        <field name="scale_mid_label">Average</field>
        <field name="scale_max_label">Excellent</field>
        <field name="constr_mandatory">1</field>
        <field name="sequence">1</field>
    </record>
</data>
</odoo>