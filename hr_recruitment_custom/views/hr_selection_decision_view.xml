<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_selection_decision_form" model="ir.ui.view">
        <field name="name">hr.selection.decision.form</field>
        <field name="model">hr.selection.decision</field>
        <field name="arch" type="xml">
            <form string="Selection Decision">
                <header>
                    <button name="action_print_decision" type="object"
                            string="Print" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="year"/>
                            <field name="degree"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="manager_name"/>
                            <field name="entity_name"/>
                            <field name="sector"/>
                            <field name="letter_number"/>
                            <field name="letter_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Selected Applicants">
                            <field name="applicant_ids">
                                <list>
                                    <field name="partner_name"/>
                                    <field name="job_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_selection_decision_list" model="ir.ui.view">
        <field name="name">hr.selection.decision.list</field>
        <field name="model">hr.selection.decision</field>
        <field name="arch" type="xml">
            <list string="Selection Decisions">
                <field name="name"/>
                <field name="date"/>
                <field name="job_id"/>
                <field name="manager_name"/>
                <field name="applicant_count"/>
            </list>
        </field>
    </record>

    <record id="action_hr_selection_decision" model="ir.actions.act_window">
        <field name="name">Selection Decisions</field>
        <field name="res_model">hr.selection.decision</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hr_selection_decision"
        name="Selection Decisions"
        parent="hr_recruitment.menu_crm_case_categ0_act_job"
        action="action_hr_selection_decision"
        sequence="4"
        groups="hr_recruitment_custom.group_selection_affairs,hr_recruitment_custom.group_general_secretariat"/>

</odoo>