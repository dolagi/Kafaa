<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_news_news_list" model="ir.ui.view">
        <field name="name">news.news.list</field>
        <field name="model">news.news</field>
        <field name="arch" type="xml">
            <list string="News">
                <field name="title"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_news_news_form" model="ir.ui.view">
        <field name="name">news.news.form</field>
        <field name="model">news.news</field>
        <field name="arch" type="xml">
            <form string="News">
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="not is_published"/>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="News title"/>
                        </h1>
                    </div>
                    <group>
                        <field name="is_published"/>
                    </group>
                    <field name="image" widget="image" class="w-100" options="{'size': [1024, 512]}"/>
                    <notebook>
                        <page string="Content">
                            <field name="content"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_news_news" model="ir.actions.act_window">
        <field name="name">News</field>
        <field name="res_model">news.news</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>