<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_exam_center_form" model="ir.ui.view">
        <field name="name">exam.center.form</field>
        <field name="model">exam.center</field>
        <field name="arch" type="xml">
            <form string="Exam Center">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exam_center_tree" model="ir.ui.view">
        <field name="name">exam.center.tree</field>
        <field name="model">exam.center</field>
        <field name="arch" type="xml">
            <list string="Exam Centers">
                <field name="name"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="exam_center_action" model="ir.actions.act_window">
        <field name="name">Exam Centers</field>
        <field name="res_model">exam.center</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_exam_center_root" name="Exam Centers" action="exam_center_action" parent="hr_recruitment.menu_hr_recruitment_config_applications"/>

</odoo>