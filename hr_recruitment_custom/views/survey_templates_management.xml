<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <template id="survey_navigation" inherit_id="survey.survey_navigation">
        <xpath expr="//button[@t-att-value]" position="attributes">
            <attribute name="t-att-value">'next' if survey.survey_type == 'assessment' or not survey_last else 'finish'</attribute>
            <attribute name="t-att-disabled">not can_go_forward or (survey.survey_type == 'assessment' and survey_last)</attribute>
        </xpath>
        <!-- Replace back chevron (first button) with "Previous" -->
        <xpath expr="//i[contains(@class,'oi-chevron-left')]" position="replace">
            <span class="px-2">Previous</span>
        </xpath>
        <xpath expr="//i[contains(@class,'oi-chevron-right')]" position="replace">
            <span class="px-2">Next</span>
        </xpath>
    </template>
</data></odoo>
