<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Extend Candidate Form -->
    <record id="hr_candidate_form_view_inherit_graduation" model="ir.ui.view">
        <field name="name">hr.candidate.form.inherit.graduation</field>
        <field name="model">hr.candidate</field>
        <field name="inherit_id" ref="hr_recruitment.hr_candidate_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'me-2')]" position="before">
                <div class="o_form_image float-start me-3">
                    <field name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        options="{'preview_image': 'image_1920'}"
                        readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_name']" position="attributes">
                <attribute name="readonly" >1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="nationality_no" readonly="1"/>
                <field name="gender" readonly="1"/>
                <field name="birth_date" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly" >1</attribute>
            </xpath>
            <xpath expr="//field[@name='email_from']" position="attributes">
                <attribute name="readonly" >1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_phone']" position="attributes">
                <attribute name="readonly" >1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="nationality" readonly="1"/>
                <field name="residence_country"/>
                <field name="residence_city"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="education" string="Education">
                    <field name="education_ids">
                        <list>
                            <field name="university"/>
                            <field name="graduation_year"/>
                            <field name="graduation_month"/>
                            <field name="specialization_id"/>
                            <field name="certification"/>
                            <field name="university_location"/>
                        </list>
                    </field>
                </page>
                <page name="experience" string="Experiences">
                    <field name="experience_ids">
                        <list>
                            <field name="job_title"/>
                            <field name="company_name"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="country"/>
                            <field name="city"/>
                        </list>
                    </field>
                </page>
                <page name="languages" string="Languages">
                    <field name="language_ids">
                        <list>
                            <field name="language_name"/>
                            <field name="proficiency"/>
                        </list>
                    </field>
                </page>
                <field name="selection_decision_count" invisible="1"/>
                <page string="Selection Decision" invisible="not selection_decision_count">
                    <field name="selection_decision_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="job_id"/>
                            <field name="entity_name"/>
                            <field name="letter_number"/>
                            <field name="letter_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='type_id']" position="attributes">
                <attribute name="invisible" >1</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_candidate_view_form" model="ir.ui.view">
        <field name="name">hr.candidate.form.inherit.graduation</field>
        <field name="model">hr.candidate</field>
        <field name="inherit_id" ref="hr_recruitment_skills.hr_candidate_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="attributes">
                <attribute name="invisible" >1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_candidate_specialization_form" model="ir.ui.view">
        <field name="name">candidate.specialization.form</field>
        <field name="model">candidate.specialization</field>
        <field name="arch" type="xml">
            <form string="Specialization">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_candidate_specialization_tree" model="ir.ui.view">
        <field name="name">candidate.specialization.tree</field>
        <field name="model">candidate.specialization</field>
        <field name="arch" type="xml">
            <list string="Specializations">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_candidate_specialization" model="ir.actions.act_window">
        <field name="name">Specializations</field>
        <field name="res_model">candidate.specialization</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem
        id="menu_candidate_specialization"
        name="Specializations"
        action="action_candidate_specialization"
        parent="hr_recruitment.menu_hr_recruitment_config_applications"
        sequence="20"/>

</odoo>