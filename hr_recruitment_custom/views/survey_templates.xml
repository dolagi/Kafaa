<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <template id="survey_layout_logo_position" inherit_id="survey.layout">
        <xpath expr="//div[@t-call='web.brand_promotion_message']" position="replace">
            <div class="o_recruitment_survey_logo">
                <img src="/hr_recruitment_custom/static/src/img/KafaatLogo.png"
                     alt="National Government Recruitment Platform"/>
            </div>
        </xpath>
    </template>
    <template id="survey_exam_review_navigation" inherit_id="survey.survey_fill_form">
        <xpath expr="//form" position="attributes">
            <attribute name="t-att-data-first-exam-page-id">survey._get_pages_or_questions(answer)[:1].id if answer and survey.questions_layout != 'one_page' else None</attribute>
            <attribute name="t-att-data-exam-review-page-ids">json.dumps(survey._get_pages_or_questions(answer).filtered(lambda item: item not in answer._get_inactive_conditional_questions()).ids) if answer and survey.questions_layout != 'one_page' else '[]'</attribute>
        </xpath>
    </template>
    <template id="survey_explicit_exam_submission" inherit_id="survey.survey_fill_form_in_progress">
        <xpath expr="//t[@t-if=&quot;survey.questions_layout == 'page_per_section'&quot;]//button[@t-att-value='submit_value']" position="attributes">
            <attribute name="t-att-data-explicit-exam-submit">'1' if survey.survey_type == 'assessment' and not answer.is_session_answer else None</attribute>
        </xpath>
        <xpath expr="//div[@t-if=&quot;survey.questions_layout == 'page_per_question'&quot;]//button[@t-att-value='submit_value']" position="attributes">
            <attribute name="t-att-data-explicit-exam-submit">'1' if survey.survey_type == 'assessment' and not answer.is_session_answer else None</attribute>
        </xpath>
        <xpath expr="//t[@t-if=&quot;survey.questions_layout == 'one_page'&quot;]//button[@type='submit']" position="replace">
            <button type="submit" value="finish" class="btn btn-secondary disabled"
                    t-att-data-explicit-exam-submit="'1' if survey.survey_type == 'assessment' and not answer.is_session_answer else None">Continue</button>
        </xpath>
        <xpath expr="//t[@t-if=&quot;survey.questions_layout == 'page_per_section'&quot;]//t[@t-if=&quot;submit_value == 'finish'&quot;]" position="replace">
            <t t-if="submit_value == 'finish'">Continue</t>
        </xpath>
        <xpath expr="//div[@t-if=&quot;survey.questions_layout == 'page_per_question'&quot;]//t[@t-if=&quot;submit_value == 'finish'&quot;]" position="replace">
            <t t-if="submit_value == 'finish'">Continue</t>
        </xpath>
    </template>
    <template id="survey_fill_form_done" inherit_id="survey.survey_fill_form_done">
        <!-- Hide "Take Again" button -->
        <xpath expr="//t[@t-call='survey.survey_button_retake']" position="replace"/>
        <!-- Hide "Review your answers" button -->
        <xpath expr="//p[a[contains(@class,'o_survey_review')]]" position="replace"/>
    </template>

    <template id="survey_fill_header" inherit_id="survey.survey_fill_header">
        <xpath expr="//h1[contains(@class,'o_survey_main_title')]" position="after">
            <t t-if="answer and answer.partner_id">
                <h4 class="text-muted mt-2">
                    Hello, <t t-esc="answer.partner_id.name"/>
                </h4>
            </t>
        </xpath>
    </template>
        <template id="survey_fill_form_done_feedback" inherit_id="survey.survey_fill_form_done">
        <xpath expr="//div[hasclass('o_survey_finished')]" position="inside">
            <t t-if="answer and answer.feedback_survey_url">
                <div class="mt-4 text-center">
                    <p class="text-muted">We would love to hear your feedback about the recruitment process.</p>
                    <a t-att-href="answer.feedback_survey_url"
                    class="btn btn-primary btn-lg">
                        Rate the Recruitment Process
                    </a>
                </div>
            </t>
        </xpath>
    </template>
</data>
</odoo>
